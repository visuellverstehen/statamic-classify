{
    "name": "visuellverstehen/statamic-classify",
    "description": "A useful helper to add CSS classes to all HTML tags generated by the bard editor.",
    "keywords": [
        "statamic",
        "addon",
        "bard",
        "css",
        "prose",
        "typography",
        "v5",
        "v6"
    ],
    "license": "MIT",
    "type": "statamic-addon",
    "autoload": {
        "psr-4": {
            "VV\\Classify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VV\\Classify\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "visuellverstehen"
        }
    ],
    "support": {
        "email": "hello@visuellverstehen.de"
    },
    "require": {
        "php": "^8.3",
        "statamic/cms": "^5.0 || ^6.0",
        "symfony/dom-crawler": "^6.0 || ^7.0 || ^8.0",
        "symfony/css-selector": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.17 || ^10.11 || ^11.0",
        "pestphp/pest": "^4.0"
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "extra": {
        "statamic": {
            "name": "Statamic Classify",
            "description": "A useful helper to add CSS classes to all HTML tags generated by the bard editor."
        },
        "laravel": {
            "providers": [
                "VV\\Classify\\ServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": false,
            "pestphp/pest-plugin": true
        }
    }
}
